{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostline.quest/schemas/race-route-v1.json",
  "title": "Ghostline race route",
  "type": "object",
  "required": ["format", "schema_version", "id", "title", "prefix", "looped", "width_default", "speed_mps", "marks"],
  "properties": {
    "format": {"const": "ghostline-race-route"},
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "prefix": {"$ref": "#/$defs/id"},
    "looped": {"type": "boolean"},
    "width_default": {"type": "number", "minimum": 0.1},
    "speed_mps": {"type": "number", "minimum": 0.1},
    "world": {"type": "object", "description": "Explicit native course layout overrides, including finish, water and dressing."},
    "marks": {"type": "array", "items": {"$ref": "#/$defs/mark"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "position": {"type": "object", "required": ["x", "y", "z"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}},
    "mark": {
      "type": "object", "required": ["id", "role", "order", "position", "yaw"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["spline_point", "checkpoint", "start_grid", "player_start", "staging", "activation", "finish", "opponent_exit", "recovery", "reward", "spectator", "hazard", "boundary", "gps", "prop", "speed_change", "width_change"]},
        "order": {"type": "integer", "minimum": 0},
        "name": {"type": "string"}, "notes": {"type": "string"},
        "position": {"$ref": "#/$defs/position"}, "yaw": {"type": "number"},
        "options": {"type": "object"}, "evidence": {"type": "object"},
        "native_ref": {"type": "string"}, "native_trigger_ref": {"type": "string"}
      }
    }
  }
}
