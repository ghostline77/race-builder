{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ghostline.quest/schemas/race-series-v1.json",
  "title":"Race championship",
  "type":"object",
  "additionalProperties":false,
  "required":["format","schema_version","id","title","contact_name","intro_message","completion_message","reward_eddies","races"],
  "properties":{
    "format":{"const":"ghostline-race-series"},
    "schema_version":{"const":1},
    "id":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*$"},
    "title":{"type":"string","minLength":1},
    "contact_name":{"type":"string","minLength":1},
    "intro_message":{"type":"string","minLength":1},
    "completion_message":{"type":"string","minLength":1},
    "reward_eddies":{"type":"integer","minimum":1,"maximum":2147483647},
    "quest_core_slot":{"type":"integer","minimum":1,"maximum":64},
    "races":{"type":"array","minItems":1,"maxItems":32,"items":{
      "type":"object","additionalProperties":false,"required":["title","project","invitation"],
      "properties":{
        "title":{"type":"string","minLength":1},
        "project":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*$"}]},
        "invitation":{"type":"string"}
      }
    }}
  }
}
